{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api?__path=$1" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 9 * * 1-5" }
  ]
}
